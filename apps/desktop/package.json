{
  "name": "@chitra/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Chitra desktop shell",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@chitra/core": "workspace:*",
    "@chitra/composer": "workspace:*",
    "@chitra/templates": "workspace:*",
    "@chitra/exports": "workspace:*",
    "@dagrejs/dagre": "1.1.4",
    "@excalidraw/excalidraw": "0.17.6",
    "@xyflow/react": "12.3.2",
    "electron-updater": "6.3.9",
    "fflate": "0.8.2",
    "framer-motion": "11.11.1",
    "html-to-image": "1.11.11",
    "keytar": "7.9.0",
    "konva": "9.3.16",
    "nanoid": "5.0.7",
    "react-konva": "18.2.10",
    "docx": "8.5.0",
    "zod": "3.23.8",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "@tailwindcss/vite": "4.0.0-beta.3",
    "electron": "32.1.2",
    "electron-builder": "25.0.5",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.0.0-beta.3",
    "typescript": "5.6.3",
    "vite": "5.4.8"
  }
}
