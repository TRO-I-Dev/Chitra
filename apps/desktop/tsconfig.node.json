{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "lib": ["ES2022"],
    "outDir": "out/main",
    "noEmit": true,
    "paths": {
      "@main/*": ["./src/main/*"],
      "@chitra/core": ["../../packages/core/src/index.ts"],
      "@chitra/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "electron.vite.config.ts"]
}
