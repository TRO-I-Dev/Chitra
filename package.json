{
  "name": "chitra",
  "version": "0.0.1",
  "private": true,
  "description": "Chitra — writing-to-card studio for architecture & business plans",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "airboard:assets": "node tools/fetch-airboard-assets.mjs",
    "predev": "pnpm airboard:assets",
    "dev": "pnpm --filter @chitra/web dev",
    "predev:desktop": "pnpm airboard:assets",
    "dev:desktop": "pnpm --filter @chitra/desktop dev",
    "prebuild": "pnpm airboard:assets",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @chitra/web build",
    "prebuild:desktop": "pnpm airboard:assets",
    "build:desktop": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @chitra/desktop build",
    "prepackage:desktop": "pnpm airboard:assets",
    "package:desktop": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @chitra/desktop package",
    "preview": "pnpm --filter @chitra/web preview",
    "start:desktop": "pnpm --filter @chitra/desktop start",
    "test": "pnpm --filter @chitra/web test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "puppeteer-core": "^24.43.1",
    "typescript": "5.6.3"
  }
}
