{
  "name": "chitra",
  "version": "0.0.1",
  "private": true,
  "description": "Chitra — writing-to-card studio for architecture & business plans",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @chitra/desktop dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @chitra/desktop build",
    "build:win": "pnpm build && pnpm --filter @chitra/desktop build:win",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.6.3"
  }
}
